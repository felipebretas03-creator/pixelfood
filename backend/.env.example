# ==========================================
# BANCO DE DADOS (PostgreSQL / Supabase)
# ==========================================
# Connection string do pooler de conexões (porta 6543 no Supabase Transaction mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Connection string direta para migrations do Prisma (porta 5432 no Supabase Session mode)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ==========================================
# SERVIDOR & SEGURANÇA
# ==========================================
PORT=4000
NODE_ENV="production"
JWT_SECRET="gere-um-segredo-jwt-forte-com-openssl-rand-hex-32"

# Chave de criptografia de 32 bytes em Base64 para armazenar chaves do Mercado Pago
PAYMENT_CREDENTIALS_ENCRYPTION_KEY="gere-com-openssl-rand-base64-32"

# Origens permitidas extras no CORS (separadas por vírgula)
CORS_ORIGINS="https://pixeleats.com.br,https://painel.pixeleats.com.br"

# ==========================================
# ASAAS (Assinaturas SaaS do Lojista)
# ==========================================
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_API_KEY="$aact_sua_chave_de_producao_asaas"
ASAAS_WEBHOOK_SECRET="seu-token-de-autenticacao-webhook-asaas"

# ==========================================
# RESEND (E-mails Transacionais)
# ==========================================
RESEND_API_KEY="re_sua_chave_resend"
EMAIL_FROM="PixelEats <nao-responda@pixeleats.com.br>"

# ==========================================
# FEATURE FLAGS
# ==========================================
FEATURE_ONLINE_PAYMENTS_ENABLED="true"

